<Project Sdk="Microsoft.NET.Sdk">

  <!-- Integration tests via Aspire.Hosting.Testing arrive in M3-5 (reference to the AppHost then). -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Exit code 8 = zero tests ran. Remove this line when M3-5 adds the first test. -->
    <TestingPlatformCommandLineArguments>--ignore-exit-code 8</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cs2Market.TestSupport\Cs2Market.TestSupport.csproj" />
  </ItemGroup>

</Project>
